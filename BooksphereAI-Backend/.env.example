FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value

# Ports 5433/6380 (not the Postgres/Redis defaults 5432/6379) —
# remapped to avoid colliding with other projects' containers that
# may already be running on a shared dev machine.
DATABASE_URL=postgresql://booksphere:booksphere@localhost:5433/booksphere_dev
TEST_DATABASE_URL=postgresql://booksphere:booksphere@localhost:5433/booksphere_test
REDIS_URL=redis://localhost:6380/0
RATELIMIT_STORAGE_URI=redis://localhost:6380/0

JWT_SECRET_KEY=replace-with-a-long-random-value
